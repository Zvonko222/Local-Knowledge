<UserControl x:Class="LocalKnowledgeBase.Desktop.Views.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = MemoryViewModel（由 App.xaml 的 DataTemplate 关联） -->
    <ScrollViewer x:Name="PageScroll"
                  Background="{StaticResource BackgroundBrush}"
                  Padding="0"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{Binding ElementName=PageScroll, Path=ViewportWidth, Converter={StaticResource ResponsivePageWidthConverter}}"
                    Margin="34,28,34,40"
                    HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{DynamicResource Str_Mem_Title}" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="{DynamicResource Str_Mem_Subtitle}"
                           Margin="0,6,0,0"
                           Style="{StaticResource BodyText}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Mem_Form}" Style="{StaticResource HeadingMedium}" />
                            <TextBlock Text="{DynamicResource Str_Mem_FormHint}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="9,5"
                                CornerRadius="12"
                                Background="#FFF4E3">
                            <TextBlock Text="{DynamicResource Str_Badge_LongTerm}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Str_Field_Title}" Style="{StaticResource HeadingSmall}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Str_Field_Tags}" Style="{StaticResource HeadingSmall}" />
                            <TextBox Margin="0,5,0,0"
                                     ToolTip="使用逗号分隔多个标签"
                                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Field_Content}"
                               Margin="0,14,0,0"
                               Style="{StaticResource HeadingSmall}" />
                    <TextBox Height="280"
                             Margin="0,5,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Width="108"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;"
                                               Margin="0,0,7,0"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding SaveButtonText}" />
                                </StackPanel>
                            </Button>

                            <Button Width="92"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;"
                                               Margin="0,0,7,0"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14" />
                                    <TextBlock Text="{DynamicResource Str_Btn_Clear}" />
                                </StackPanel>
                            </Button>

                            <Button Width="92"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;"
                                               Margin="0,0,7,0"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14" />
                                    <TextBlock Text="{DynamicResource Str_Btn_Delete}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   MaxWidth="420"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource CaptionText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Mem_List}"
                           VerticalAlignment="Center"
                           Style="{StaticResource HeadingMedium}" />

                <TextBox Grid.Column="1"
                         Width="240"
                         Height="36"
                         ToolTip="按标题、标签或正文筛选"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" />

                <Button Grid.Column="2"
                        Width="82"
                        Height="36"
                        Margin="8,0,0,0"
                        Content="清空"
                        Style="{StaticResource SecondaryButton}"
                        Click="ClearFilterButton_Click" />
            </Grid>

            <DataGrid MinHeight="200"
                      Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Title}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Title}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Tags}" Width="170">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Tags}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=d}" Width="125">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Created}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding UpdatedAt, StringFormat=g}" Width="145">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Updated}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
