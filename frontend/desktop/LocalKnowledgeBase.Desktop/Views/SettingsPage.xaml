<UserControl x:Class="LocalKnowledgeBase.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = SettingsViewModel（由 App.xaml 的 DataTemplate 关联） -->
    <ScrollViewer x:Name="PageScroll"
                  Background="{StaticResource BackgroundBrush}"
                  Padding="0"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{Binding ElementName=PageScroll, Path=ViewportWidth, Converter={StaticResource ResponsivePageWidthConverter}}"
                    Margin="34,28,34,40"
                    HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{DynamicResource Str_Set_Title}" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="{DynamicResource Str_Set_Subtitle}"
                           Margin="0,6,0,0"
                           Style="{StaticResource BodyText}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_DataDir}" Style="{StaticResource HeadingMedium}" />
                            <TextBlock Text="{DynamicResource Str_DataDir_Desc}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="9,5"
                                CornerRadius="12"
                                Background="{StaticResource PrimarySoftBrush}">
                            <TextBlock Text="{DynamicResource Str_Badge_Local}"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox IsReadOnly="True"
                                 Text="{Binding DataDirectory, Mode=OneWay}"
                                 Style="{StaticResource ModernTextBox}" />

                        <Button Grid.Column="1"
                                Width="108"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding PickDirectoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_PickDir}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Width="108"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="在资源管理器中打开数据目录，便于查看与备份"
                                Command="{Binding OpenDataDirectoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_OpenDir}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Width="96"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="把整个数据目录压缩为一个 ZIP 备份文件"
                                Command="{Binding BackupDataCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Backup}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Width="76"
                                Margin="8,0,0,0"
                                Content="{DynamicResource Str_Btn_Apply}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyDirectoryCommand}" />
                    </Grid>

                    <TextBlock Margin="0,11,0,0"
                               Text="{Binding DirectoryStatusText}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Api_Title}" Style="{StaticResource HeadingMedium}" />
                    <TextBlock Text="{DynamicResource Str_Api_Desc}"
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox ToolTip="例如 https://localhost:7047"
                                 Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />

                        <Button Grid.Column="1"
                                Width="96"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ApplyApiUrlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="应用" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Width="104"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding TestConnectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Test}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="#F7F9F7">
                        <TextBlock Text="{Binding ApiStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Profile_Title}" Style="{StaticResource HeadingMedium}" />
                            <TextBlock Text="{DynamicResource Str_Profile_Desc}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Height="38"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  ItemsSource="{Binding ProfileOptions}"
                                  SelectedItem="{Binding ProfileLabel}" />

                        <Button Grid.Column="1"
                                Width="96"
                                Height="38"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Content="{DynamicResource Str_Btn_Apply}"
                                Command="{Binding ApplyProfileCommand}" />
                    </Grid>

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="#F7F9F7">
                        <TextBlock Text="{Binding ProfileStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="语言 / Language" Style="{StaticResource HeadingMedium}" />
                    <TextBlock Text="{DynamicResource Str_Lang_Desc}"
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Height="38"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding LanguageLabel}" />

                        <Button Grid.Column="1"
                                Width="96"
                                Height="38"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Content="{DynamicResource Str_Btn_Apply}"
                                Command="{Binding ApplyLanguageCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="背景颜色" Style="{StaticResource HeadingMedium}" />
                    <TextBlock Text="{DynamicResource Str_Theme_Desc}"
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Height="38"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  ItemsSource="{Binding BackgroundOptions}"
                                  SelectedItem="{Binding BackgroundLabel}" />

                        <Button Grid.Column="1"
                                Width="96"
                                Height="38"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Content="{DynamicResource Str_Btn_Apply}"
                                Command="{Binding ApplyBackgroundCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="本地模型（AI 问答）" Style="{StaticResource HeadingMedium}" />
                            <TextBlock Text="OpenAI 兼容接口：云端 API（GLM、DeepSeek 等，需密钥）或本地服务（Ollama 等）均可。问答时先检索知识库，再交由该模型生成回答。"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="9,5"
                                CornerRadius="12"
                                Background="#EAF3F8">
                            <TextBlock Text="检索在本机"
                                       Foreground="#1F6F8B"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="服务商预设"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HeadingSmall}" />
                        <ComboBox Width="220"
                                  Height="38"
                                  Margin="10,0,0,0"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  ItemsSource="{Binding ProviderOptions}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  ToolTip="选择后自动填充地址与示例模型（以 DeepSeek 填写方式为准）" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox ToolTip="OpenAI 兼容接口地址，例如 https://api.deepseek.com/v1 或 http://localhost:11434/v1"
                                 Text="{Binding LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />

                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 ToolTip="模型名称，例如 glm-4.7、deepseek-chat、qwen2.5:7b"
                                 Text="{Binding LlmModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />

                        <TextBox Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,8,0,0"
                                 ToolTip="云端 API（GLM / DeepSeek / OpenAI 等）必填；本地服务（Ollama 等）留空"
                                 Text="{Binding LlmApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />

                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Width="96"
                                Margin="10,8,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ApplyLlmSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="应用" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="2"
                                Grid.Column="3"
                                Width="104"
                                Margin="8,8,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding TestLlmCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Test}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="#F7F9F7">
                        <TextBlock Text="{Binding LlmStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{StaticResource SidebarBrush}">
                        <TextBlock Text="LK"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13"
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Local Knowledge Base"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="本地优先的知识库与项目记忆工具"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="v1.0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="12" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
