<UserControl x:Class="LocalKnowledgeBase.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = SettingsViewModel（由 App.xaml 的 DataTemplate 关联） -->
    <ScrollViewer x:Name="PageScroll"
                  Background="{StaticResource BackgroundBrush}"
                  Padding="0"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{Binding ElementName=PageScroll, Path=ViewportWidth, Converter={StaticResource ResponsivePageWidthConverter}}"
                    Margin="34,28,34,40"
                    HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="设置" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="存储位置与服务连接"
                           Margin="0,6,0,0"
                           Style="{StaticResource BodyText}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="数据目录" Style="{StaticResource HeadingMedium}" />
                            <TextBlock Text="知识库、原始文件与索引数据都会保存在这里。"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="9,5"
                                CornerRadius="12"
                                Background="{StaticResource PrimarySoftBrush}">
                            <TextBlock Text="本地存储"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox IsReadOnly="True"
                                 Text="{Binding DataDirectory, Mode=OneWay}"
                                 Style="{StaticResource ModernTextBox}" />

                        <Button Grid.Column="1"
                                Width="108"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding PickDirectoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="选择目录" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Width="76"
                                Margin="8,0,0,0"
                                Content="应用"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyDirectoryCommand}" />
                    </Grid>

                    <TextBlock Margin="0,11,0,0"
                               Text="{Binding DirectoryStatusText}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="API 服务" Style="{StaticResource HeadingMedium}" />
                    <TextBlock Text="桌面客户端通过此地址访问本地 Web API。"
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox ToolTip="例如 https://localhost:7047"
                                 Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />

                        <Button Grid.Column="1"
                                Width="96"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ApplyApiUrlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="应用" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Width="104"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding TestConnectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="测试连接" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="#F7F9F7">
                        <TextBlock Text="{Binding ApiStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{StaticResource SidebarBrush}">
                        <TextBlock Text="LK"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13"
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Local Knowledge Base"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="本地优先的知识库与项目记忆工具"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="v1.0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="12" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
