<UserControl x:Class="LocalKnowledgeBase.Desktop.Views.DocumentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="Page_DragOver"
             Drop="Page_Drop">
    <!-- DataContext = DocumentsViewModel（由 App.xaml 的 DataTemplate 关联） -->
    <ScrollViewer x:Name="PageScroll"
                  Background="{StaticResource BackgroundBrush}"
                  Padding="0"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Width="{Binding ElementName=PageScroll, Path=ViewportWidth, Converter={StaticResource ResponsivePageWidthConverter}}"
                    Margin="34,28,34,40"
                    HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{DynamicResource Str_Docs_Title}" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="{DynamicResource Str_Docs_Subtitle}"
                           Margin="0,6,0,0"
                           Style="{StaticResource BodyText}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Width="120"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ImportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Import}" />
                            </StackPanel>
                        </Button>

                        <Button Width="100"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Refresh}" />
                            </StackPanel>
                        </Button>

                        <Button Width="108"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="把整个知识库导出为 Markdown 文件合集（每篇一个 .md + 索引）"
                                Command="{Binding ExportAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_ExportAll}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               MaxWidth="420"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusText}"
                               Style="{StaticResource CaptionText}" />
                </Grid>
            </Border>

            <!-- 标签分类芯片：点选即过滤，可与右侧关键词筛选叠加 -->
            <ListBox Style="{StaticResource TagChipListBox}"
                     ItemContainerStyle="{StaticResource TagChipItem}"
                     ItemsSource="{Binding TagFilters}"
                     SelectedItem="{Binding SelectedTagFilter}"
                     Visibility="{Binding HasTagFilters, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Str_List_Docs}"
                           VerticalAlignment="Center"
                           Style="{StaticResource HeadingMedium}" />

                <TextBox Grid.Column="1"
                         Width="260"
                         Height="36"
                         ToolTip="按标题、标签、类型或正文筛选"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" />

                <Button Grid.Column="2"
                        Width="82"
                        Height="36"
                        Margin="8,0,0,0"
                        Content="{DynamicResource Str_Btn_Clear}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearFilterCommand}" />
            </Grid>

            <!-- 高度自适应：整页滚动（外层 ScrollViewer），避免固定高度吃掉滚轮 -->
            <DataGrid MinHeight="220"
                      Margin="0,0,0,14"
                      Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Title}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Title}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Tags}" Width="145">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Tags}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FileType}" Width="74">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Type}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Width="92">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Size}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding UpdatedAt, StringFormat=g}" Width="145">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str_Col_Updated}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Detail_Title}" Style="{StaticResource HeadingMedium}" />
                            <TextBlock Text="{Binding DetailMeta}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="9,5"
                                CornerRadius="12"
                                Background="{StaticResource PrimarySoftBrush}">
                            <TextBlock Text="{DynamicResource Str_Badge_Editable}"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Str_Field_Title}" Style="{StaticResource HeadingSmall}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding DetailTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Str_Field_Tags}" Style="{StaticResource HeadingSmall}" />
                            <TextBox Margin="0,5,0,0"
                                     ToolTip="使用逗号分隔多个标签"
                                     Text="{Binding DetailTags, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Field_Content}"
                               Margin="0,14,0,0"
                               Style="{StaticResource HeadingSmall}" />
                    <TextBox Height="340"
                             Margin="0,5,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding DetailContent, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Width="116"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_SaveChanges}" />
                            </StackPanel>
                        </Button>

                        <Button Width="106"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="把文档正文导出为 .md 文件"
                                Command="{Binding ExportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Export}" />
                            </StackPanel>
                        </Button>

                        <Button Width="132"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="在资源管理器中定位该文档的原始文件"
                                Command="{Binding OpenFileLocationCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_FileLocation}" />
                            </StackPanel>
                        </Button>

                        <Button Width="106"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;"
                                           Margin="0,0,7,0"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14" />
                                <TextBlock Text="{DynamicResource Str_Btn_Delete}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 相关文档：基于向量索引的语义关联，点击在列表中定位 -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasRelatedDocuments, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource Str_Related_Title}" Style="{StaticResource HeadingSmall}" />
                        <ItemsControl ItemsSource="{Binding RelatedDocuments}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,6"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="点击在列表中定位该文档"
                                            Command="{Binding DataContext.SelectRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding DocumentId}">
                                        <TextBlock Text="{Binding Label}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
