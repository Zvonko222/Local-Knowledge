<Window x:Class="LocalKnowledgeBase.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Knowledge Base"
        Height="760"
        Width="1240"
        MinHeight="640"
        MinWidth="980"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- DataContext 由 App.xaml.cs 组合根注入（ShellViewModel），不要在 XAML 里再创建。 -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            CornerRadius="8"
                            Background="{StaticResource PrimaryBrush}">
                        <Grid>
                            <TextBlock Text="LK"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <Border Width="7"
                                    Height="7"
                                    Margin="0,0,5,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="4"
                                    Background="{StaticResource AccentBrush}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,1,0,0">
                        <TextBlock Text="Local Knowledge"
                                   Foreground="White"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Base"
                                   Foreground="{StaticResource NavTextBrush}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{DynamicResource Str_Sidebar_Workspace}"
                               Margin="12,0,0,8"
                               Foreground="#70807B"
                               FontSize="11"
                               FontWeight="SemiBold" />

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Style="{StaticResource NavListBox}"
                             ItemContainerStyle="{StaticResource NavListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}"
                                               Width="24"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="16" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="2"
                        Padding="12"
                        CornerRadius="8"
                        Background="#1E2B28"
                        BorderBrush="#2B3A36"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Sidebar_LocalFirst}"
                                   Foreground="#E8EFEC"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.IsApiConnected}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Status.ApiDetail}"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource NavTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 当前页面：App.xaml 中的 DataTemplate 把页面 ViewModel 映射成对应视图 -->
            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

            <Border Grid.Row="1" Style="{StaticResource StatusBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Status.StatusMessage}"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="API"
                                   Style="{StaticResource CaptionText}" />
                        <Border Width="6"
                                Height="6"
                                Margin="8,0,7,0"
                                VerticalAlignment="Center"
                                CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.IsApiConnected}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding Status.ApiDetail}"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
