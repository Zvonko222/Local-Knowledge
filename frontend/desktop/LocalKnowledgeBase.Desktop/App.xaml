<Application x:Class="LocalKnowledgeBase.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalKnowledgeBase.Desktop.ViewModels"
             xmlns:views="clr-namespace:LocalKnowledgeBase.Desktop.Views"
             xmlns:converters="clr-namespace:LocalKnowledgeBase.Desktop.Converters">
    <!-- 注意：不设置 StartupUri，主窗口由 App.xaml.cs 通过容器创建并注入 ShellViewModel。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ModernDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:ResponsivePageWidthConverter x:Key="ResponsivePageWidthConverter" />
            <converters:FileSizeConverter x:Key="FileSizeConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 页面 ViewModel → View 映射：内容区显示某个页面 ViewModel 时自动实例化对应视图。 -->
            <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
                <views:DocumentsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
                <views:MemoryPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <views:SearchPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
